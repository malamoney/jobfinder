# Default test database for local development. Assumes a Postgres reachable on
# localhost trusting the current OS user, which is how Homebrew's postgresql
# formula ships. The database is created by the test global setup if absent.
#
# Override in .env.test.local (gitignored) if your Postgres wants credentials.
# Values already present in the environment win over this file, which is how CI
# points the suite at its service container.
TEST_DATABASE_URL=postgres://localhost:5432/jobfinder_test
BETTER_AUTH_SECRET=test-secret-not-used-anywhere-real
BETTER_AUTH_URL=http://localhost:3000
