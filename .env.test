# Default test database for local development. Assumes a Postgres reachable on
# localhost trusting the current OS user, which is how Homebrew's postgresql
# formula ships. The database is created by the test global setup if absent.
#
# Override in .env.test.local (gitignored) if your Postgres wants credentials.
# Values already present in the environment win over this file, which is how CI
# points the suite at its service container.
TEST_DATABASE_URL=postgres://localhost:5432/jobfinder_test
BETTER_AUTH_SECRET=test-secret-not-used-anywhere-real
BETTER_AUTH_URL=http://localhost:3000

# No pause between geocoder calls in tests — MSW answers them and there is no
# rate limit to respect. Production leaves this unset and waits a second between
# calls, as Nominatim's usage policy asks.
GEOCODER_MIN_INTERVAL_MS=0

# A stand-in Logo.dev publishable token so the company-logo URL is deterministic
# in tests (`format.test.ts`). Nothing calls Logo.dev in the suite.
NEXT_PUBLIC_LOGODEV_TOKEN=pk_test_logodev

# No routing provider in the suite by default, which is the fresh-clone state:
# the commute tab renders with no drive times and calls nobody. The tests that
# cover the drive windows stub a key in themselves (`commute.test.ts`).
TOMTOM_API_KEY=
