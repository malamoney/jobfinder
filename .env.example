# Copy to .env.local and fill in.

# Neon Postgres, pooled connection string. Reached over the standard Postgres
# wire protocol, so a local Postgres works here too during development.
DATABASE_URL=postgres://localhost:5432/jobfinder

# Only needed if your Postgres differs from the default in .env.test. Put the
# override in .env.test.local rather than here.
# TEST_DATABASE_URL=postgres://localhost:5432/jobfinder_test

# better-auth signs session cookies with this. Generate one with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=

# Where the application is reached, e.g. https://jobfinder.vercel.app. Unset,
# better-auth derives its origin from the request Host header, which is fine
# locally and is not something to rely on once deployed.
BETTER_AUTH_URL=

# Company logos on the Dashboard are looked up by name from Logo.dev's CDN
# (ADR 0011). This token is publishable — it is sent to the browser — so the
# value below is the real one, not a placeholder. Get your own at
# https://logo.dev. Unset, every card falls back to a monogram.
NEXT_PUBLIC_LOGODEV_TOKEN=pk_IPrj8kOnQIudA-TVM_oA9w

# The nightly Fetch cron (vercel.json) is a public URL. Set this and Vercel
# sends it as a Bearer token on the cron request; the route refuses anything
# else. Generate one with:
#   openssl rand -hex 32
# Unset in local development — the cron does not run there.
CRON_SECRET=

# Typical morning and evening drive times on a Posting's commute tab come from
# TomTom's Routing API (ADR 0015). Its free tier is 2,500 requests a day and
# needs no credit card; get a key at https://developer.tomtom.com. Unset, the
# tab renders everything else and simply shows no times — never an estimate.
TOMTOM_API_KEY=
